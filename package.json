{
  "name": "craig-watt-website",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "workspaces": [
    "services/*",
    "platform/*"
  ],
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=10.x"
  },
  "scripts": {
    "dev": "cd services/website && next dev",
    "build": "cd services/website && next build --webpack",
    "start": "node ./tools/static-server.mjs services/website/out",
    "lint": "eslint . --max-warnings=0",
    "storybook": "storybook dev -c services/website/.storybook -p 6006",
    "build-storybook": "storybook build -c services/website/.storybook -o services/website/storybook-static",
    "test": "jest --config jest.config.cjs",
    "e2e": "playwright test -c services/website-e2e/playwright.config.ts",
    "build:functions": "node ./tools/build-functions.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-ses": "^3.1111.0",
    "@content-collections/core": "^0.15.2",
    "@content-collections/next": "^0.2.11",
    "@heroui/react": "^2.8.2",
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.3.1",
    "content-collections": "^0.2.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "swr": "^2.5.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@mdx-js/react": "^3.1.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-links": "^10.5.8",
    "@storybook/builder-vite": "^10.5.8",
    "@storybook/nextjs": "^10.5.8",
    "@storybook/react": "^10.5.8",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "storybook": "^10.5.8",
    "tailwindcss": "4.3.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "glob": "^9.0.0",
    "rimraf": "^6.0.1",
    "inflight": "^2.0.0",
    "cross-spawn": "7.0.6",
    "abab": "2.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@heroui/shared-utils",
      "@swc/core",
      "core-js-pure",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
